# Public values bundled in the mobile application. RLS must protect all data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# UUID assigned by `eas init`; needed only after linking the repository to an Expo project.
EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000

# Never add SUPABASE_SERVICE_ROLE_KEY to this file or to an EAS mobile profile.
